generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  nom           String
  prenom        String
  email         String         @unique
  emailVerified DateTime?
  password      String?
  role          Role           @default(VOLUNTEER)
  photo         String?
  statut        UserStatut     @default(ACTIF)
  deletedAt     DateTime?
  date_entree   DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  activites     Activite[]
  credits       Credit[]
  observations  Observation[]
  partages      Partage[]
  presences     Attendance[]
  temoignages   Temoignage[]
  sexe          String        @default("Non précisé")
  age           Int           @default(18)
  contact       String?
  categorie     Category      @default(UNIVERSITAIRE)
  etablissement String        @default("Non renseigné")
  facebook      String?
  matricule     String?             @unique
  societe       String?
  telephone     String?
  dateNaissance DateTime?
  siteWeb       String?
  cvUrl         String?
  socialProfile String?
  joursDisponibles String[]         @default([])
  disponibilites Json?
  contactUrgence String?
  spinneret     String?
  accepteRegles Boolean             @default(false)
  reglesAccepteesAt DateTime?
  materielPC    Boolean             @default(false)
  createdById   Int?
  createdBy     User?               @relation("CreatedBy", fields: [createdById], references: [id])
  createdUsers  User[]              @relation("CreatedBy")
  certificatUrl String?
  certificatStatut CertificatStatut  @default(NON_DEMANDE)
  certificatValidatedAt DateTime?
  certificatValidatedById Int?

  @@index([certificatStatut])
  @@index([role, statut])
  @@index([createdById])
}

model Seat {
  id          Int          @id @default(autoincrement())
  tableNumber Int
  seatNumber  Int
  label       String?
  presences   Attendance[]

  @@unique([tableNumber, seatNumber])
  @@index([tableNumber])
}

model Attendance {
  id            Int      @id @default(autoincrement())
  user_id       Int
  date          DateTime @db.Date
  seat_id       Int?
  heure_arrivee String?
  heure_depart  String?
  statut        String   @default("PRESENT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  seat          Seat?    @relation(fields: [seat_id], references: [id], onDelete: Restrict)

  @@unique([user_id, date])
  @@unique([seat_id, date])
  @@index([date])
}

model Observation {
  id        Int      @id @default(autoincrement())
  user_id   Int
  mois      Int
  annee     Int
  contenu   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Credit {
  id        Int      @id @default(autoincrement())
  user_id   Int
  montant   Float
  date      DateTime @default(now())
  motif     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Activite {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  titre       String
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [user_id], references: [id])
}

model Partage {
  id               Int      @id @default(autoincrement())
  user_id          Int?
  titre            String
  contenu          String
  date_publication DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User?    @relation(fields: [user_id], references: [id])
}

model Temoignage {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  nom_auteur String
  contenu    String
  statut     String   @default("EN_ATTENTE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User?    @relation(fields: [user_id], references: [id])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VOLUNTEER
  USER
}

enum CertificatStatut {
  NON_DEMANDE
  EN_ATTENTE
  APPROUVE
  REJETE
}

enum UserStatut {
  ACTIF
  INACTIF
}

enum Category {
  PRIMAIRE
  COLLEGIEN
  UNIVERSITAIRE
  SALARIE
}
