# Database Connection (PostgreSQL)
# Local: postgresql://tahiry:tahiry4534@localhost:5432/gestion_benevole?schema=public
DATABASE_URL=""

# Shadow Database (for Prisma migrations)
SHADOW_DATABASE_URL=""

# NextAuth Config
# En dev, NE PAS fixer NEXTAUTH_URL : Next.js utilise 3000 et passe automatiquement
# à 3001, 3002... si le port est occupé. AUTH_TRUST_HOST dérive l'origine NextAuth
# de l'en-tête Host → l'app fonctionne sur le port réel du serveur.
# NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
NEXTAUTH_SECRET=""

# App Environment
NODE_ENV="development"
